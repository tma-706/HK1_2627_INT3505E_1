      "name": "error-cases",
      "item": [
        {
          "name": "POST /books — missing title",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"returns title validation error\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"VALIDATION_ERROR\");",
                  "    pm.expect(body.message).to.eql(\"Invalid book data\");",
                  "    pm.expect(body.errors[0].field).to.eql(\"title\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"No Title Author\",\n  \"year\": 2024\n}",
              "options": {
                "raw": {
                  "language": "json"
