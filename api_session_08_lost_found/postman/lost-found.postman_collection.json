{
  "info": {
    "_postman_id": "263230c1-d2c8-4272-ae35-0429144c5767",
    "name": "AI Lost & Found — Session 08 Homework",
    "description": "Stateful functional tests for a minimal Lost & Found API. Matching uses mock-keyword-v1, not SigLIP2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "happy-path",
      "item": [
        {
          "name": "01 — Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service is healthy\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"ok\");",
                  "  pm.expect(body.service).to.eql(\"lost-found-api\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "response": []
        },
        {
          "name": "02 — Login seeker",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns seeker token and user schema\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.user.email).to.eql(\"seeker@example.com\");",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"seeker_token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seeker@example.com\",\n  \"password\": \"seeker123\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "response": []
        },
        {
          "name": "03 — Create Lost Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"creates a LOST draft\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.type).to.eql(\"LOST\");",
                  "  pm.expect(body.status).to.eql(\"DRAFT\");",
                  "  pm.expect(body.id).to.be.above(0);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"lost_post_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lost black backpack\",\n  \"description\": \"Black backpack with a blue keychain\",\n  \"category\": \"BAG\",\n  \"location\": \"Main Library\",\n  \"event_time\": \"2026-11-16T09:00:00+07:00\",\n  \"image_urls\": []\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/lost-posts"
          },
          "response": []
        },
        {
          "name": "04 — Publish Lost Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"publishes immediately and queues matching\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"PUBLISHED\");",
                  "  pm.expect(body.matching_status).to.eql(\"QUEUED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "url": "{{base_url}}/api/v1/posts/{{lost_post_id}}/publish"
          },
          "response": []
        },
        {
          "name": "05 — Login finder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns finder token\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.user.email).to.eql(\"finder@example.com\");",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"finder_token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"finder@example.com\",\n  \"password\": \"finder123\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "response": []
        },
        {
          "name": "06 — Create Found Post with image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"creates a FOUND draft with media metadata\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.type).to.eql(\"FOUND\");",
                  "  pm.expect(body.status).to.eql(\"DRAFT\");",
                  "  pm.expect(body.image_urls).to.have.lengthOf(1);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"found_post_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{finder_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Black backpack found\",\n  \"description\": \"Found a black backpack with a blue keychain\",\n  \"category\": \"BAG\",\n  \"location\": \"Main Library\",\n  \"event_time\": \"2026-11-16T10:00:00+07:00\",\n  \"image_urls\": [\"https://example.test/images/backpack.jpg\"]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/found-posts"
          },
          "response": []
        },
        {
          "name": "07 — Publish Found Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"publishes image-backed FOUND post\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.type).to.eql(\"FOUND\");",
                  "  pm.expect(body.status).to.eql(\"PUBLISHED\");",
                  "  pm.expect(body.matching_status).to.eql(\"QUEUED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{finder_token}}"}
            ],
            "url": "{{base_url}}/api/v1/posts/{{found_post_id}}/publish"
          },
          "response": []
        },
        {
          "name": "08 — Get Top 5 matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns bounded mock matching results\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.model_version).to.eql(\"mock-keyword-v1\");",
                  "  pm.expect(body.items).to.be.an(\"array\");",
                  "  pm.expect(body.count).to.be.at.most(5);",
                  "  pm.expect(body.items[0].candidate.type).to.eql(\"FOUND\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "url": "{{base_url}}/api/v1/lost-posts/{{lost_post_id}}/matches?limit=5"
          },
          "response": []
        },
        {
          "name": "09 — Create claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"creates a pending claim\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"PENDING\");",
                  "  pm.expect(body.evidence).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"claim_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lost_post_id\": {{lost_post_id}},\n  \"evidence\": \"The inside pocket has my student card holder.\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/found-posts/{{found_post_id}}/claims"
          },
          "response": []
        },
        {
          "name": "10 — Get private claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the saved claim schema\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"claim_id\")));",
                  "  pm.expect(body).to.have.all.keys(\"id\", \"lost_post_id\", \"found_post_id\", \"claimant_id\", \"evidence\", \"status\", \"created_at\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "url": "{{base_url}}/api/v1/claims/{{claim_id}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "error-cases",
      "item": [
        {
          "name": "11 — Create post without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", () => pm.response.to.have.status(401));",
                  "pm.test(\"returns protocol auth error\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"UNAUTHORIZED\");",
                  "  pm.expect(body.message).to.include(\"Bearer token\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Unauthorized post\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/lost-posts"
          },
          "response": []
        },
        {
          "name": "12 — Lost Post missing description",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));",
                  "pm.test(\"returns description schema error\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"VALIDATION_ERROR\");",
                  "  pm.expect(body.details).to.have.property(\"description\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing description\",\n  \"category\": \"BAG\",\n  \"location\": \"Main Library\",\n  \"event_time\": \"2026-11-16T09:00:00+07:00\",\n  \"image_urls\": []\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/lost-posts"
          },
          "response": []
        },
        {
          "name": "13 — Create Found draft without image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"image-less Found Post remains a draft\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.type).to.eql(\"FOUND\");",
                  "  pm.expect(body.status).to.eql(\"DRAFT\");",
                  "  pm.expect(body.image_urls).to.be.empty;",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"invalid_found_post_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{finder_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Found item without image\",\n  \"description\": \"A found item draft without uploaded media\",\n  \"category\": \"BAG\",\n  \"location\": \"Main Library\",\n  \"event_time\": \"2026-11-16T10:00:00+07:00\",\n  \"image_urls\": []\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{base_url}}/api/v1/found-posts"
          },
          "response": []
        },
        {
          "name": "14 — Reject publishing Found Post without image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));",
                  "pm.test(\"enforces Found Post image rule\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"IMAGE_REQUIRED\");",
                  "  pm.expect(body.message).to.include(\"at least one\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{finder_token}}"}
            ],
            "url": "{{base_url}}/api/v1/posts/{{invalid_found_post_id}}/publish"
          },
          "response": []
        },
        {
          "name": "15 — Reject match limit above 10",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));",
                  "pm.test(\"enforces Top 10 business rule\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"VALIDATION_ERROR\");",
                  "  pm.expect(body.message).to.include(\"between 1 and 10\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "url": "{{base_url}}/api/v1/lost-posts/{{lost_post_id}}/matches?limit=11"
          },
          "response": []
        },
        {
          "name": "16 — Missing post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"returns stable NOT_FOUND body\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"NOT_FOUND\");",
                  "  pm.expect(body.message).to.eql(\"Post not found\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{seeker_token}}"}
            ],
            "url": "{{base_url}}/api/v1/posts/999999"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {"key": "seeker_token", "value": "", "type": "default"},
    {"key": "finder_token", "value": "", "type": "default"},
    {"key": "lost_post_id", "value": "", "type": "default"},
    {"key": "found_post_id", "value": "", "type": "default"},
    {"key": "claim_id", "value": "", "type": "default"},
    {"key": "invalid_found_post_id", "value": "", "type": "default"}
  ]
}
