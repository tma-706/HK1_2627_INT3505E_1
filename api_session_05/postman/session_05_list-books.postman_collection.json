    {
      "name": "05 - Multi-key sort",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Books are sorted by price DESC and title ASC\", function () {\r",
              "    const books = pm.response.json().data;\r",
              "\r",
              "    for (let index = 1; index < books.length; index++) {\r",
              "        const previous = books[index - 1];\r",
              "        const current = books[index];\r",
              "\r",
              "        pm.expect(\r",
              "            previous.price >= current.price\r",
              "        ).to.eql(true);\r",
              "\r",
              "        if (previous.price === current.price) {\r",
              "            pm.expect(\r",
              "                previous.title.localeCompare(current.title) <= 0\r",
              "            ).to.eql(true);\r",
              "        }\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
