    {
      "name": "07 - Cursor first page",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Returns 3 books\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    pm.expect(body.data).to.be.an(\"array\");\r",
              "    pm.expect(body.data).to.have.lengthOf(3);\r",
              "});\r",
              "\r",
              "pm.test(\"Cursor pagination is correct\", function () {\r",
              "    const pagination = pm.response.json().pagination;\r",
              "\r",
              "    pm.expect(pagination.strategy).to.eql(\"cursor\");\r",
              "    pm.expect(pagination.limit).to.eql(3);\r",
              "    pm.expect(pagination.has_more).to.eql(true);\r",
              "    pm.expect(pagination.next_cursor).to.be.a(\"string\");\r",
              "    pm.expect(pagination.sort).to.eql(\"-price,title\");\r",
              "});\r",
              "\r",
              "pm.test(\"First cursor page has correct IDs\", function () {\r",
              "    const ids = pm.response.json().data.map(\r",
              "        book => book.id\r",
              "    );\r",
              "\r",
              "    pm.expect(ids).to.eql([2, 1, 3]);\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"nextCursor\",\r",
              "    body.pagination.next_cursor\r",
              ");\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"firstPageIds\",\r",
              "    JSON.stringify(\r",
              "        body.data.map(book => book.id)\r",
              "    )\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
