    {
      "name": "08 - Cursor next page",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Returns 3 books\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    pm.expect(body.data).to.have.lengthOf(3);\r",
              "});\r",
              "\r",
              "pm.test(\"Second page has correct IDs\", function () {\r",
              "    const ids = pm.response.json().data.map(\r",
              "        book => book.id\r",
              "    );\r",
              "\r",
              "    pm.expect(ids).to.eql([7, 8, 4]);\r",
              "});\r",
              "\r",
              "pm.test(\"Second page has no duplicate books\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    const firstPageIds = JSON.parse(\r",
              "        pm.collectionVariables.get(\r",
              "            \"firstPageIds\"\r",
              "        )\r",
              "    );\r",
              "\r",
              "    const secondPageIds = body.data.map(\r",
              "        book => book.id\r",
              "    );\r",
              "\r",
              "    secondPageIds.forEach(function (id) {\r",
              "        pm.expect(\r",
              "            firstPageIds.includes(id)\r",
              "        ).to.eql(false);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
