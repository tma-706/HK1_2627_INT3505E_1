      "name": "04 - Filter technology",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"All books are technology books\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    pm.expect(body.pagination.total).to.eql(4);\r",
              "\r",
              "    body.data.forEach(function (book) {\r",
              "        pm.expect(book.genre).to.eql(\"technology\");\r",
              "    });\r",
              "});"
            ],
