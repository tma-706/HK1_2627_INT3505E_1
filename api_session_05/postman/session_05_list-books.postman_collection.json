    {
      "name": "01 - Offset first page",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains 3 books\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    pm.expect(body.data).to.be.an(\"array\");\r",
              "    pm.expect(body.data).to.have.lengthOf(3);\r",
              "});\r",
              "\r",
              "pm.test(\"Pagination information is correct\", function () {\r",
              "    const pagination = pm.response.json().pagination;\r",
              "\r",
              "    pm.expect(pagination.strategy).to.eql(\"offset\");\r",
              "    pm.expect(pagination.offset).to.eql(0);\r",
              "    pm.expect(pagination.limit).to.eql(3);\r",
              "    pm.expect(pagination.total).to.eql(12);\r",
              "    pm.expect(pagination.has_next).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?strategy=offset&offset=0&limit=3",
